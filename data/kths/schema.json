            ],
            "title": "Site",
            "type": "object"
        },
        "SocialMediaHandle": {
            "description": "Represents a social media handle associated with an entity",
            "properties": {
                "platform": {
                    "description": "The social media platform (e.g., Instagram, Facebook, YouTube)",
                    "examples": [
                        "YouTube"
                    ],
                    "title": "Platform",
                    "type": "string"
                },
                "handle": {
                    "description": "The social media handle or username",
                    "examples": [
                        "@example_handle"
                    ],
                    "title": "Handle",
                    "type": "string"
                },
                "url": {
                    "description": "The URL of the social media profile",
                    "examples": [
                        "https://youtube.com/@example_handle"
                    ],
                    "format": "uri",
                    "minLength": 1,
                    "title": "URL",
                    "type": "string"
                }
            },
            "required": [
                "platform",
                "handle",
                "url"
            ],
            "title": "Social Media Handle",
            "type": "object"
        },
        "VocabularyEntry": {
            "description": "Represents a single entry within a classification vocabulary",
            "properties": {
                "id": {
                    "description": "The identifier for the vocabulary entry within the classification",
                    "examples": [
                        "A21",
                        "B19"
                    ],
                    "title": "ID",
                    "type": "string"
                },
                "title": {
                    "description": "The title of the vocabulary entry",
                    "examples": [
                        "Sports activities",
                        "Culture and arts not elsewhere classified"
                    ],
                    "title": "Title",
                    "type": "string"
                },
                "parent": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/VocabularyEntry"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The parent entry within the vocabulary, if any",
                    "title": "Parent"
                }
            },
            "required": [
                "id",
                "title"
            ],
            "title": "VocabularyEntry",
            "type": "object"
        },
        "VocabularyModel": {
            "description": "Represents a classification vocabulary",
            "properties": {
                "id": {
                    "description": "The unique identifier for the vocabulary",
                    "examples": [
                        "ICNPTSO",
                        "ICNPO",
                        "UK-CAT",
                        "SIC2007"
                    ],
                    "title": "ID",
                    "type": "string"
                },
                "title": {
                    "description": "The title of the vocabulary",
                    "examples": [
                        "International Classification of Nonprofit and Third Sector Organisations",
                        "International Classification of Nonprofit Organisations",
                        "UK Charities Activity Taxonomy",
                        "Standard Industrial Classification 2007"
                    ],
                    "title": "Title",
                    "type": "string"
                },
                "entries": {
                    "description": "The list of entries within this vocabulary",
                    "items": {
                        "$ref": "#/$defs/VocabularyEntry"
                    },
                    "title": "Entries",
                    "type": "array"
                },
                "single": {
                    "default": false,
                    "description": "Indicates whether the vocabulary is intended to only have one entry per entity",
                    "title": "Single",
                    "type": "boolean"
                }
            },
            "required": [
                "id",
                "title"
            ],
            "title": "VocabularyModel",
            "type": "object"
        }
    },
    "anyOf": [
        {
            "$ref": "#/$defs/OperatorModel"
        },
        {
            "$ref": "#/$defs/ClassificationEntry"
        },
        {
            "$ref": "#/$defs/VocabularyModel"
        }
    ],
    "title": "KTHS Schema",
    "$schema": "https://json-schema.org/draft/2020-12/schema"
}
