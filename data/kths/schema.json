        },
        "SocialMediaHandle": {
            "description": "Represents a social media handle associated with an entity",
            "properties": {
                "platform": {
                    "description": "The social media platform (e.g., Twitter, Facebook)",
                    "title": "Platform",
                    "type": "string"
                },
                "handle": {
                    "description": "The social media handle or username",
                    "title": "Handle",
                    "type": "string"
                },
                "url": {
                    "description": "The URL of the social media profile",
                    "format": "uri",
                    "minLength": 1,
                    "title": "URL",
                    "type": "string"
                }
            },
            "required": [
                "platform",
                "handle",
                "url"
            ],
            "title": "Social Media Handle",
            "type": "object"
