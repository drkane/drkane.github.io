{
    "$defs": {
        "AnnualModel": {
            "description": "Represents an annual record associated with an entity",
            "properties": {
                "financial_year_end": {
                    "anyOf": [
                        {
                            "format": "date",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The end date of the financial year for this annual record",
                    "examples": [
                        "2023-03-31"
                    ],
                    "title": "Financial Year End"
                },
                "financial_year_start": {
                    "anyOf": [
                        {
                            "format": "date",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The start date of the financial year for this annual record",
                    "examples": [
                        "2022-04-01"
                    ],
                    "title": "Financial Year Start"
                },
                "turnover": {
                    "default": null,
                    "description": "The turnover for this annual record, in pounds",
                    "examples": [
                        100000.0
                    ],
                    "title": "Turnover",
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "expenditure": {
                    "default": null,
                    "description": "The expenditure for this annual record, in pounds",
                    "examples": [
                        80000.0
                    ],
                    "title": "Expenditure",
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "profit_surplus": {
                    "default": null,
                    "description": "The profit or surplus for this annual record, in pounds",
                    "examples": [
                        20000.0
                    ],
                    "title": "Profit/Surplus",
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "assets": {
                    "default": null,
                    "description": "The assets or reserves at the end of the financial year for this annual record, in pounds",
                    "examples": [
                        50000.0
                    ],
                    "title": "Assets",
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "number_of_employees": {
                    "default": null,
                    "description": "The number of employees for this annual record, as a full time equivalent",
                    "examples": [
                        50
                    ],
                    "title": "Number of Employees",
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "volunteer_hours": {
                    "default": null,
                    "description": "The number of volunteer hours for this annual record, as number of volunteer hours per year",
                    "examples": [
                        1000
                    ],
                    "title": "Volunteer Hours",
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "n_directors": {
                    "default": null,
                    "description": "The number of directors or trustees for this annual record",
                    "examples": [
                        5
                    ],
                    "title": "Number of Directors",
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            },
            "title": "Annual Record",
            "type": "object"
        },
        "AreaSource": {
            "enum": [
                "Postcode",
                "Area Code",
                "Point"
            ],
            "title": "AreaSource",
            "type": "string"
        },
        "ClassificationEntry": {
            "description": "Represents a single entry for classifying an entity to a vocabulary term\n\nThese are used to create the final classification for an entity. This is done by\nordering the classification entries based on their scores, with higher scores indicating greater confidence.\n\nThe `last_updated` field should be used as a tie-breaker when scores are equal, with later timestamps\ntaking precedence.\n\nFor entries where the `Vocabulary` is single, the highest scoring entry should be selected as the final classification.\n\nFor entries where the `Vocabulary` allows multiple entries, all entries with sufficiently high scores\nshould be considered for the final classification.\n\nIf a classification entry is marked with `exclude=True`, all entries for that term with a lower score\nshould be disregarded when determining the final classification.",
            "properties": {
                "entity": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/OperatorModel"
                        },
                        {
                            "$ref": "#/$defs/SiteModel"
                        }
                    ],
                    "description": "The entity being classified",
                    "title": "Entity"
                },
                "term": {
                    "$ref": "#/$defs/VocabularyEntry",
                    "description": "The vocabulary term for this classification entry",
                    "title": "Term"
                },
                "score": {
                    "description": "The confidence score for this classification entry. Higher values indicate greater confidence.",
                    "title": "Score",
                    "type": "integer"
                },
                "exclude": {
                    "default": false,
                    "description": "Indicates whether this classification entry indicates that the term should be excluded from consideration. False means that this is a positive result for the classification",
                    "title": "Exclude",
                    "type": "boolean"
                },
                "last_updated": {
                    "description": "The timestamp of the last update for this classification entry",
                    "format": "date-time",
                    "title": "Last Updated",
                    "type": "string"
                }
            },
            "required": [
                "entity",
                "term",
                "score",
                "last_updated"
            ],
            "title": "ClassificationEntry",
            "type": "object"
        },
        "ContactDetails": {
            "description": "Represents the contact details of an entity",
            "properties": {
                "email": {
                    "default": null,
                    "description": "The email address for contacting the entity",
                    "examples": [
                        "example@example.com"
                    ],
                    "title": "Email",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "phone": {
                    "default": null,
                    "description": "The phone number for contacting the entity",
                    "examples": [
                        "+441234567890"
                    ],
                    "title": "Phone",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "address": {
                    "description": "The postal address of the entity",
                    "examples": [
                        [
                            "123 Example Street",
                            "Example Town",
                            "SW1A 1AA"
                        ]
                    ],
                    "items": {
                        "type": "string"
                    },
                    "title": "Address",
                    "type": "array"
                }
            },
            "title": "Contact Details",
            "type": "object"
        },
