                    ],
                    "default": null,
                    "description": "The parent entity of this entity, if applicable",
                    "title": "Parent Entity"
                },
                "locations": {
                    "description": "List of locations associated with this entity",
                    "items": {
                        "$ref": "#/$defs/LocationModel"
                    },
                    "title": "Locations",
                    "type": "array"
                },
                "geographic_range": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/GeographicRange"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The geographic range of the entity",
                    "title": "Geographic Range"
                },
                "website_url": {
                    "anyOf": [
                        {
                            "format": "uri",
                            "minLength": 1,
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The website URL of the entity",
                    "title": "Website URL"
                },
                "social_media_handles": {
                    "description": "List of social media handles associated with this entity",
                    "items": {
                        "$ref": "#/$defs/SocialMediaHandle"
                    },
                    "title": "Social Media Handles",
                    "type": "array"
                },
                "contact_details": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ContactDetails"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
